{
	"name": "frontend",
	"version": "0.0.1",
	"private": false,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --fail-on-warnings --tsconfig ./tsconfig.json",
		"lint:check": "prettier --check . && DEBUG=eslint:cli-engine eslint --max-warnings 0 --cache --cache-location node_modules/.eslintcache . && knip",
		"lint:fix": "prettier --write . && DEBUG=eslint:cli-engine eslint --cache --cache-location node_modules/.eslintcache --fix ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/html-minifier-terser": "^7.0.2",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"html-minifier-terser": "^7.2.0",
		"knip": "^6.45.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	},
	"type": "module"
}
