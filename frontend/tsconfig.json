{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "svelte"],
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": false, // debugger

		"paths": {
			"$root": ["./src"],
			"$root/*": ["./src/*"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"@shared/*": ["../shared/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte", "../shared/api.ts"]
}
